# The build context is app/ only — the 2.7GB backup/ tree and the sibling
# services (dashboard, videocall, sui) never reach the daemon at all.
node_modules
.next
.next-*
.env
.env.*
!.env.example
e2e
test-results
playwright-report
.omc
okf-fs
*.log
# User uploads and avatars are runtime data written by the running app. Baking
# them in makes the image huge and, worse, silently discards everything users
# uploaded on every redeploy. They are mounted as volumes instead.
public/uploads
public/avatars
