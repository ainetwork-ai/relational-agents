# Environment variable reference — `cp .env.example .env.local` and fill in values.
# .env* is gitignored. **Never put real secrets in THIS file** (it is committed).

# ── required ─────────────────────────────────────────────────────────────
# local Postgres (compose project notion-clone → 5434; 5432/5433 belong to other projects)
POSTGRES_URL=postgresql://notion_clone:notion_clone_dev@localhost:5434/notion_clone
# iron-session signing key — 32+ random chars. `openssl rand -hex 24`
SESSION_SECRET=change-me-32-chars-minimum-random
# OKF content root = the content DB (folder tree IS the DB). Relationship docs are written here as
# files. Unset falls back to ./okf-fs under app/; prod mounts a volume (see docker-compose.prod.yml)
OKF_ROOT=/absolute/path/to/okf-content

# ── Google sign-in (the only way in) ────────────────────────────────────
# Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web app).
# Scopes: openid email profile. The redirect URI must match the console entry
# EXACTLY — path included — or the code exchange fails with redirect_uri_mismatch.
# Google only accepts http for localhost; every other origin must be https.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3110/api/auth/google/callback

# ── LLM (shared by memory writing, answering, and send-guard) ───────────
# OpenAI-compatible endpoint. Defaults to this host's local vLLM
AI_URL=http://localhost:8100/v1
AI_MODEL=gemma-4-31B-it

# ── relationship agent ──────────────────────────────────────────────────
# memory-write auto trigger: immediately at K+ unprocessed messages, else after N ms idle
AGENT_BATCH_SIZE=10
AGENT_IDLE_MS=120000
# host **fallback** for generated a2aUrls. The request origin wins (handles
# auto-assigned ports), so this can usually stay unset — only background code
# paths without a request context use it
# A2A_BASE_URL=http://192.168.1.193:36700

# ── public origin ────────────────────────────────────────────────────────
# The origin people open this app on, e.g. https://ainmem.ainetwork.ai. It is used for
# links written into text other people read: the page URLs in a prompt made from a page
# (family agent, page menu, /api/pages/<id>/prompt, MCP page-to-prompt), which is saved
# into a shared page. When unset, the origin of GOOGLE_REDIRECT_URI is used, and when
# that is unset too, links stay relative (/p/<id>). They are never taken from a request.
# In dev (no PORT) it is also how the server reaches itself for x402 payments.
# APP_ORIGIN=http://localhost:3110

# ── external system tokens (setting one opens that path; use random secrets) ──
# for services calling /api/mcp without a human session — public content only
# MCP_SERVICE_TOKEN=
# token this app attaches when delivering to external A2A bots
# A2A_SERVICE_TOKEN=

# ── aindrive (linked drive files, read & write over aindrive's MCP) ──────
# Server whose /mcp endpoint serves the drive, and the drive owner's session
# JWT (`aindrive login` → ~/.aindrive/credentials.json sessionCookie). Both set
# = the aindrive-* MCP tools and per-agent links (agentConfig.aindrive) work.
# AINDRIVE_SERVER=https://aindrive.ainetwork.ai
# Optional service token: only for work with no connected person behind it
# (links made before per-person accounts). People connect their own aindrive
# account in the app (browser-session approval), and calls run as them.
# AINDRIVE_TOKEN=
# Default link for /api/mcp callers without their own: a drive id, optionally
# confined to a folder inside it.
# AINDRIVE_DRIVE_ID=
# AINDRIVE_ROOT=
# Extra drive ids that may be linked (Home, a teamspace, a room's agent). Links
# outside these and the default are refused. "*" offers every drive of the
# logged-in aindrive account (the whole account behind AINDRIVE_TOKEN).
# AINDRIVE_ALLOWED_DRIVES=
# aindrive's web origin as people open it, when it differs from AINDRIVE_SERVER
# (pasted aindrive file links are recognised by it)
# AINDRIVE_PUBLIC_URL=
# How this app names itself on aindrive's connect-approval page (default ainmem)
# AINDRIVE_CLIENT_NAME=

# ── test/dev only (never set in production) ─────────────────────────────
# 1 = deterministic behavior without calling the LLM (used by e2e)
# AGENT_FAKE_LLM=1
# AI_FAKE_LLM=1
# only when smoke-testing a prod build over LAN http (drops Secure cookies)
# INSECURE_COOKIES=1
# md mirror output path (default: md-mirror/ at the repo root)
# MD_MIRROR_ROOT=

# ── on-chain contract (relational agent contract) ───────────────────────
# RelationalAgentRegistry deployment address/chain — the EIP-712 signing domain anchors here.
# see contracts/deployments/sepolia.json. Unset = zero-address domain (dev only)
# NEXT_PUBLIC_RELATION_REGISTRY_ADDRESS=
# NEXT_PUBLIC_RELATION_REGISTRY_CHAIN_ID=11155111

# ── x402 gifts (lib/x402) ─────────────────────────────────────────────────
# Where a gift's payment is signed and settled: auto (aindrive when its x402
# tools are there for the account, else the family ledger), ledger, aindrive.
# GIFT_SETTLEMENT=auto
# aindrive's pay tools, by name (defaults: x402_wallet / x402_sign / x402_settle)
# AINDRIVE_X402_WALLET_TOOL=
# AINDRIVE_X402_SIGN_TOOL=
# AINDRIVE_X402_SETTLE_TOOL=
