# Environment variable reference — `cp .env.example .env.local` and fill in values.
# .env* is gitignored. **Never put real secrets in THIS file** (it is committed).

# ── required ─────────────────────────────────────────────────────────────
# local Postgres (compose project notion-clone → 5434; 5432/5433 belong to other projects)
POSTGRES_URL=postgresql://notion_clone:notion_clone_dev@localhost:5434/notion_clone
# iron-session signing key — 32+ random chars. `openssl rand -hex 24`
SESSION_SECRET=change-me-32-chars-minimum-random
# OKF content root = the content DB (folder tree IS the DB). Relationship docs are written here as files
OKF_ROOT=/absolute/path/to/memory-data/content

# ── LLM (shared by memory writing, answering, and send-guard) ───────────
# OpenAI-compatible endpoint. Defaults to this host's local vLLM
AI_URL=http://localhost:8100/v1
AI_MODEL=gemma-4-31B-it

# ── relationship agent ──────────────────────────────────────────────────
# memory-write auto trigger: immediately at K+ unprocessed messages, else after N ms idle
AGENT_BATCH_SIZE=10
AGENT_IDLE_MS=120000
# host **fallback** for generated a2aUrls. The request origin wins (handles
# auto-assigned ports), so this can usually stay unset — only background code
# paths without a request context use it
# A2A_BASE_URL=http://192.168.1.193:36700

# ── external system tokens (setting one opens that path; use random secrets) ──
# for services calling /api/mcp without a human session — public content only
# MCP_SERVICE_TOKEN=
# token this app attaches when delivering to external A2A bots
# A2A_SERVICE_TOKEN=

# ── test/dev only (never set in production) ─────────────────────────────
# 1 = deterministic behavior without calling the LLM (used by e2e)
# AGENT_FAKE_LLM=1
# AI_FAKE_LLM=1
# only when smoke-testing a prod build over LAN http (drops Secure cookies)
# INSECURE_COOKIES=1
# md mirror output path (default: md-mirror/ at the repo root)
# MD_MIRROR_ROOT=

# ── on-chain contract (relational agent contract) ───────────────────────
# RelationalAgentRegistry deployment address/chain — the EIP-712 signing domain anchors here.
# see contracts/deployments/sepolia.json. Unset = zero-address domain (dev only)
# NEXT_PUBLIC_RELATION_REGISTRY_ADDRESS=
# NEXT_PUBLIC_RELATION_REGISTRY_CHAIN_ID=11155111
