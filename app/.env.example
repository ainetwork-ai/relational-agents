# 환경변수 예시 — `cp .env.example .env.local` 후 값을 채운다.
# .env* 는 gitignore 대상이다. **실제 시크릿을 이 파일에 쓰지 말 것** (여기는 커밋된다).

# ── 필수 ─────────────────────────────────────────────────────────────────
# 로컬 Postgres (compose 프로젝트 notion-clone → 5434. 5432/5433은 남의 것)
POSTGRES_URL=postgresql://notion_clone:notion_clone_dev@localhost:5434/notion_clone
# iron-session 서명 키 — 32자 이상 랜덤. `openssl rand -hex 24`
SESSION_SECRET=change-me-32-chars-minimum-random
# OKF 콘텐츠 루트 = 콘텐츠 DB(폴더=DB). 관계 문서도 여기에 파일로 쓰인다
NOTION_FS_ROOT=/absolute/path/to/notion-data/content

# ── LLM (기억 쓰기·답변·발송 검증에 공통) ───────────────────────────────
# OpenAI 호환 엔드포인트. 기본값은 이 호스트의 로컬 vLLM
AI_URL=http://localhost:8100/v1
AI_MODEL=gemma-4-31B-it

# ── 관계 에이전트 ────────────────────────────────────────────────────────
# 기억 쓰기 자동 트리거: 미처리 K건 이상이면 즉시 / 아니면 유휴 N ms 후
AGENT_BATCH_SIZE=10
AGENT_IDLE_MS=120000
# 생성되는 a2aUrl의 호스트 **폴백**. 요청 origin이 우선 적용되므로(포트 자동 배정
# 대응) 보통 비워둬도 된다. 요청 컨텍스트가 없는 백그라운드 경로에서만 쓰인다
# A2A_BASE_URL=http://192.168.1.193:36700

# ── 외부 시스템 토큰 (설정하면 그 경로가 열린다. 랜덤 시크릿 사용) ──────
# /api/mcp 를 사람 세션 없이 호출할 서비스용 — 공개 콘텐츠만 열람 가능
# MCP_SERVICE_TOKEN=
# 우리 앱이 외부 A2A 봇에게 배달할 때 실어 보내는 토큰
# A2A_SERVICE_TOKEN=

# ── 테스트·개발 전용 (프로덕션에서 설정 금지) ───────────────────────────
# 1이면 LLM을 부르지 않고 결정적으로 동작 (e2e에서 사용)
# AGENT_FAKE_LLM=1
# AI_FAKE_LLM=1
# LAN http 로 prod 빌드를 스모크할 때만 (Secure 쿠키 해제)
# INSECURE_COOKIES=1
# md 미러 출력 경로 (기본: 저장소 루트의 md-mirror/)
# MD_MIRROR_ROOT=
