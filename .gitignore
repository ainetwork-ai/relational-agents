# runtime/session state — never commit
.omc/
app/.omc/
.playwright-mcp/
md-mirror/

# personal/runtime data — caches, raw originals, generated content.
# user uploads are runtime data, not source
app/public/uploads/
app/public/avatars/
.claude/scheduled_tasks.lock

# production runtime state — the live OKF content tree and DB dumps.
# Lives in the project so deploys are discoverable, but is data, not source.
/deploy/
/deploy-xyz/

# local backups (not source)
/backup/

# Demo videos live on YouTube, not in git
assets/*.mp4
*.mp4

# Notion DOM captures for comparison — local reference material, not source.
# A single file is up to 1.4MB and would weigh the repo down. Which capture is
# which screen is listed in docs/notion-captures.md.
docs/*.html
docs/plus_page_personalpage_html
# Notion clipboard captures (internal data) — input for e2e/notion-paste.check.mjs.
# How to take them again: that script's header and docs/notion-captures.md.
docs/notion-clip-flow-page/
# CDP measurement scripts against the original (Notion) — local tools, not source (docs/notion-golden-set.md §4)
/scratchpad/
